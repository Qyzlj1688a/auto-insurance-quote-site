# このファイルは docker-compose.yml が読み込む環境変数のテンプレートです。
# 初回起動前に、このファイルを ".env" という名前でコピーし、
# 実際の値（特にJWT_SECRET）を必ず自分の環境用に変更してください。
#
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# ".env" はGit管理対象外（.gitignoreで除外）です。絶対にリポジトリへコミットしないでください。

# 管理者JWT（HS256）の署名用シークレットキー。
# 32文字（256bit）以上のランダムな文字列を設定してください。
# 例: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# PostgreSQLの接続情報（必要に応じて変更可能。未変更でも動作します）
POSTGRES_DB=quote_db
POSTGRES_USER=quote_user
POSTGRES_PASSWORD=quote_pass
