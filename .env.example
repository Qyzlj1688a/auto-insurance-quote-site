# .env の参考テンプレートです。
# 本リポジトリには課題検証用の .env を同梱しているため、通常はコピー作業は不要です。
# 公開サーバーへデプロイする場合など、値を変更して再作成する際の参考として利用してください。

# 管理者JWT（HS256）の署名用シークレットキー（課題検証用）
JWT_SECRET=T&S_Auto_Insurance_Secret_Key_2026_06_25

# PostgreSQLの接続情報（未変更でも動作します）
POSTGRES_DB=quote_db
POSTGRES_USER=quote_user
POSTGRES_PASSWORD=quote_pass

# フロントエンドへのアクセス元（CORS許可オリジン）
# ローカル起動: http://localhost:5173 のみで可
# 公開サーバーでデプロイする場合は、実際にブラウザでアクセスするURLを追加してください
# 例: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<サーバーIP>:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
